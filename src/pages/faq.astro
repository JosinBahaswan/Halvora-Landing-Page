---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import Icon from '../components/Icon.astro';
import { faq, kategori } from '../data/faq';
import { SHOPEE_24S, SHOPEE_30S } from '../data/produk';

const tags = ['24s vs 30s', 'ukuran', 'retur', 'pencucian'];
---
<Layout
  title="FAQ & Bantuan — HALVORA"
  description="Jawaban seputar kaos polos Cotton Combed 24s dan 30s HALVORA: bahan, ukuran XS–5XL, cara pesan di Shopee, pengiriman, dan pengembalian."
>
  <Navbar />
  <main class="mx-auto w-full max-w-7xl grow px-6 pt-12 pb-20 lg:px-12">
    <!-- Hero + pencarian -->
    <section class="mx-auto mb-16 max-w-3xl text-center">
      <h1 class="mb-4 text-4xl font-semibold tracking-tight md:text-5xl">Pusat Bantuan &amp; Pertanyaan Umum</h1>
      <p class="mx-auto mb-8 max-w-2xl text-secondary md:text-lg">
        Jawaban seputar bahan Cotton Combed 24s &amp; 30s, pilihan ukuran XS–5XL, dan cara memesan lewat Shopee.
      </p>
      <div class="relative mx-auto mb-4 max-w-2xl">
        <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-secondary"><Icon name="search" class="size-5" /></span>
        <input id="faq-search" type="text" autocomplete="off" placeholder="Cari pertanyaan... (contoh: beda 24s dan 30s, ukuran)"
          class="w-full rounded border border-charcoal-dark/10 bg-surface-subtle py-3.5 pr-12 pl-12 text-sm shadow-sm transition-all focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none" />
        <button id="faq-clear" type="button" hidden aria-label="Hapus pencarian" class="absolute inset-y-0 right-4 flex items-center text-secondary hover:text-charcoal-dark">
          <Icon name="x" class="size-4" />
        </button>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-2 text-xs">
        <span class="mr-1 font-semibold tracking-wider text-secondary uppercase">Sering dicari:</span>
        {tags.map((t) => (
          <button type="button" data-tag={t} class="rounded-full border border-charcoal-dark/10 bg-surface-subtle px-3.5 py-1 text-charcoal-soft transition-colors hover:text-charcoal-dark">{t}</button>
        ))}
      </div>
    </section>

    <!-- Ringkasan -->
    <section class="mb-16 grid grid-cols-1 gap-4 md:grid-cols-3">
      <div class="rounded-xl border border-charcoal-dark/10 bg-surface-subtle p-6">
        <span class="mb-3 inline-block rounded bg-sage-muted px-2 py-0.5 text-[11px] font-semibold tracking-wider text-primary uppercase">Cotton Combed 24s</span>
        <h3 class="mb-1 font-semibold">Tebal &amp; berstruktur</h3>
        <p class="text-sm text-secondary">Kain lebih padat dan jatuhnya rapi, cocok untuk dipakai harian yang lebih rapi.</p>
      </div>
      <div class="rounded-xl border border-charcoal-dark/10 bg-surface-subtle p-6">
        <span class="mb-3 inline-block rounded bg-sage-muted px-2 py-0.5 text-[11px] font-semibold tracking-wider text-primary uppercase">Cotton Combed 30s</span>
        <h3 class="mb-1 font-semibold">Ringan &amp; sejuk</h3>
        <p class="text-sm text-secondary">Kain lebih halus dan adem, nyaman untuk cuaca hangat dan aktivitas seharian.</p>
      </div>
      <div class="rounded-xl border border-charcoal-dark/10 bg-surface-subtle p-6">
        <span class="mb-3 inline-block rounded bg-sage-muted px-2 py-0.5 text-[11px] font-semibold tracking-wider text-primary uppercase">Belanja di Shopee</span>
        <h3 class="mb-1 font-semibold">Checkout langsung</h3>
        <p class="text-sm text-secondary">Pembayaran, pengiriman, dan pengembalian diproses lewat Shopee.</p>
      </div>
    </section>

    <!-- Tab kategori -->
    <div class="mb-10 flex justify-center overflow-x-auto pb-2">
      <div class="inline-flex max-w-full rounded-xl border border-charcoal-dark/10 bg-surface-subtle p-1" role="tablist">
        {kategori.map((k, i) => (
          <button type="button" role="tab" data-kategori={k.id} aria-selected={i === 0}
            class="faq-tab rounded-lg px-4 py-2 text-sm font-medium whitespace-nowrap text-secondary transition-all hover:text-charcoal-dark">{k.label}</button>
        ))}
      </div>
    </div>

    <!-- Daftar FAQ -->
    <div class="mx-auto max-w-4xl space-y-4" id="faq-list">
      {faq.map((f, i) => (
        <article class="faq-item rounded-xl border border-charcoal-dark/10 bg-surface-subtle" data-kategori={f.kategori} data-kata={f.kata ?? ''} data-open={i === 0 ? 'true' : 'false'}>
          <button type="button" class="faq-trigger flex w-full items-center justify-between gap-4 p-5 text-left md:p-6" aria-expanded={i === 0}>
            <span class="flex items-center gap-4">
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-sage-muted text-[11px] font-semibold tracking-wider text-sage-deep">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-base font-medium md:text-lg">{f.tanya}</span>
            </span>
            <Icon name="chevron-down" class="faq-icon size-5 shrink-0 text-secondary transition-transform duration-200" />
          </button>
          <div class="faq-content">
            <div class="space-y-3 border-t border-charcoal-dark/5 px-5 pt-4 pb-6 text-sm text-secondary md:px-6 md:text-base">
              {f.jawab.map((p) => <p>{p}</p>)}
              {f.poin && (
                <ul class="list-disc space-y-1.5 pl-5">
                  {f.poin.map((p) => <li>{p}</li>)}
                </ul>
              )}
              {f.tautan && (
                <a href={f.tautan.href} class="inline-flex items-center gap-1.5 font-medium text-charcoal-dark underline underline-offset-4 hover:text-primary">
                  {f.tautan.teks} <Icon name="arrow-right" class="size-3.5" />
                </a>
              )}
            </div>
          </div>
        </article>
      ))}

      <div id="faq-empty" hidden class="rounded-xl border border-dashed border-charcoal-dark/20 bg-surface-subtle p-10 text-center">
        <h3 class="mb-2 font-semibold">Pertanyaan tidak ditemukan</h3>
        <p class="mx-auto mb-5 max-w-md text-sm text-secondary">Coba kata kunci lain, atau tanyakan langsung lewat chat toko di Shopee.</p>
        <button id="faq-reset" type="button" class="btn-interactive rounded bg-charcoal-dark px-6 py-2.5 text-sm font-medium text-page-bg">Tampilkan semua pertanyaan</button>
      </div>
    </div>

    <!-- Bantuan -->
    <section class="mx-auto mt-20 max-w-4xl">
      <div class="flex flex-col items-center justify-between gap-8 rounded-xl border border-charcoal-dark/10 bg-surface-subtle p-8 shadow-sm md:flex-row md:p-12">
        <div class="max-w-lg text-left">
          <h2 class="mb-2 text-2xl font-semibold tracking-tight">Masih butuh saran ukuran atau punya pertanyaan lain?</h2>
          <p class="text-secondary">Tanyakan lewat chat toko di Shopee, kami bantu pilihkan ukuran yang pas.</p>
        </div>
        <div class="flex w-full shrink-0 flex-col gap-3 sm:flex-row md:w-auto md:flex-col">
          <a class="btn-interactive btn-sheen inline-flex items-center justify-center gap-2 rounded bg-shopee-orange px-8 py-3.5 text-sm font-semibold text-white hover:bg-shopee-orange-hover" href={SHOPEE_24S} rel="noopener noreferrer" target="_blank">
            <Icon name="chat" class="size-4" /><span>Chat di Shopee</span>
          </a>
          <a class="btn-interactive inline-flex items-center justify-center gap-2 rounded border border-charcoal-dark/20 bg-page-bg px-8 py-3.5 text-sm font-medium hover:bg-surface-subtle" href={SHOPEE_30S} rel="noopener noreferrer" target="_blank">
            <Icon name="store" class="size-4" /><span>Lihat produk 30s</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <StickyBar />
</Layout>

<style>
  .faq-content {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }
  .faq-item[data-open='true'] .faq-content { max-height: 600px; opacity: 1; }
  .faq-item[data-open='true'] .faq-icon { transform: rotate(180deg); }
  .faq-tab[aria-selected='true'] {
    background: var(--color-charcoal-dark);
    color: var(--color-page-bg);
    font-weight: 600;
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('.faq-item');
  const tabs = document.querySelectorAll<HTMLButtonElement>('.faq-tab');
  const input = document.getElementById('faq-search') as HTMLInputElement;
  const clearBtn = document.getElementById('faq-clear') as HTMLButtonElement;
  const empty = document.getElementById('faq-empty') as HTMLElement;
  let aktif = 'all';

  function terapkan() {
    const q = input.value.toLowerCase().trim();
    let cocokCount = 0;
    items.forEach((el) => {
      const cocokKategori = aktif === 'all' || el.dataset.kategori === aktif;
      const teks = `${el.textContent ?? ''} ${el.dataset.kata ?? ''}`.toLowerCase();
      const tampil = cocokKategori && (q === '' || teks.includes(q));
      el.hidden = !tampil;
      if (tampil) cocokCount++;
    });
    empty.hidden = cocokCount > 0;
    clearBtn.hidden = q === '';
  }

  function pilihTab(id: string) {
    aktif = id;
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.kategori === id)));
    terapkan();
  }

  // Buka-tutup (hanya satu terbuka)
  document.querySelectorAll<HTMLButtonElement>('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest<HTMLElement>('.faq-item')!;
      const buka = item.dataset.open !== 'true';
      items.forEach((el) => {
        el.dataset.open = 'false';
        el.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
      });
      if (buka) {
        item.dataset.open = 'true';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  tabs.forEach((t) => t.addEventListener('click', () => pilihTab(t.dataset.kategori!)));
  input.addEventListener('input', terapkan);
  clearBtn.addEventListener('click', () => { input.value = ''; terapkan(); });
  document.getElementById('faq-reset')!.addEventListener('click', () => { input.value = ''; pilihTab('all'); });
  document.querySelectorAll<HTMLButtonElement>('[data-tag]').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.dataset.tag!;
      terapkan();
      document.getElementById('faq-list')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );
</script>