---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const {
  title = 'HALVORA — Kaos Polos Cotton Combed 24s & 30s',
  description = 'Kaos polos O-Neck cotton combed 24s dan 30s, regular fit, ukuran XS–5XL. Pilihan warna hitam, abu tua, dan putih. Beli lewat Shopee.',
  jsonLd = [],
  noindex = false,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const situs = Astro.site;

// Data terstruktur untuk semua halaman (hanya dibuat kalau `site` sudah diisi)
const dataDasar = situs
  ? [
      { '@context': 'https://schema.org', '@type': 'Organization', name: 'HALVORA', url: situs.href },
      { '@context': 'https://schema.org', '@type': 'WebSite', name: 'HALVORA', url: situs.href, inLanguage: 'id' },
    ]
  : [];
const semuaJsonLd = [...dataDasar, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])];
const ogImage = Astro.site ? new URL('/og-image.jpg', Astro.site).href : '/og-image.jpg';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/app_favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta property="og:site_name" content="HALVORA" />
    <meta property="og:locale" content="id_ID" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kaos polos HALVORA dalam tiga warna: hitam, abu tua, dan putih" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {semuaJsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FBFBF9" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="f025chHKRQKsNFyYMm0XmjVPqB4L2Jrz8xH10JMPQBg" />
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-M927PT9C"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
  </head>
  <body class="font-sans antialiased min-h-screen flex flex-col">
    <slot />
    <script>
      // Navbar mengecil saat di-scroll
      const nav = document.getElementById('main-nav');
      const inner = document.getElementById('nav-container');
      const onScroll = () => {
        const scrolled = window.scrollY > 20;
        nav?.classList.toggle('shadow-sm', scrolled);
        inner?.classList.toggle('h-16', scrolled);
        inner?.classList.toggle('h-20', !scrolled);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Animasi muncul saat di-scroll
      const io = new IntersectionObserver((entries, o) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('fade-up-active'); o.unobserve(e.target); }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.fade-up-init').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
