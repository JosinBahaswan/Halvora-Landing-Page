---
import { Image } from 'astro:assets';
import d24 from '../assets/detail-24s.png';
import d30 from '../assets/detail-30s.png';

const items = [
  {
    img: d24, alt: 'Detail jahitan kaos Cotton Combed 24s', judul: 'Cotton Combed 24s', tag: 'Tebal & berstruktur',
    teks: 'Benang lebih tebal membuat kain jatuh lebih mantap dan menjaga bentuk kaos tetap rapi saat dipakai.',
    poin: ['100% cotton combed', 'Kerah O-neck klasik yang rapi', 'Cocok untuk kerja santai, hangout, atau layering'],
  },
  {
    img: d30, alt: 'Detail jahitan kaos Cotton Combed 30s', judul: 'Cotton Combed 30s', tag: 'Ringan & sejuk',
    teks: 'Benang lebih halus membuat kain lebih ringan dan breathable, nyaman untuk cuaca hangat dan aktivitas seharian.',
    poin: ['100% cotton combed', 'Rib, bahu, dan obras dijahit rapi', 'Cocok untuk aktivitas harian dan santai akhir pekan'],
  },
];
---
<section class="
  border-b border-charcoal-dark/10 bg-surface-subtle py-16
  md:py-24
" id="material">
  <div class="
    mx-auto max-w-7xl px-6
    lg:px-12
  ">
    <div class="mb-16 max-w-2xl">
      <span class="
        mb-2 block text-xs font-medium tracking-widest text-primary uppercase
      ">Konstruksi &amp; Material</span>
      <h2 class="
        text-3xl font-semibold tracking-tight
        md:text-4xl
      ">Detail Jahitan &amp; Pilihan Kain</h2>
      <p class="
        mt-3 text-sm/relaxed text-secondary
        md:text-base
      ">
        Dua pilihan kain dengan potongan yang sama. Bedanya ada di ketebalan benang: 24s untuk rasa yang lebih padat, 30s untuk rasa yang lebih ringan.
      </p>
    </div>
    <div class="
      grid grid-cols-1 items-start gap-12
      lg:grid-cols-2 lg:gap-16
    ">
      {items.map((it) => (
        <div class="
          craft-card space-y-6 rounded-xl border border-charcoal-dark/10
          bg-page-bg/60 p-4
        ">
          <div class="
            aspect-3/4 overflow-hidden rounded-lg border border-charcoal-dark/10
            bg-page-bg
          ">
            <Image src={it.img} alt={it.alt} widths={[480, 800]} sizes="(min-width:1024px) 40vw, 90vw" class="
              craft-img size-full object-cover
            " />
          </div>
          <div class="space-y-3">
            <div class="
              flex items-center justify-between border-b border-charcoal-dark/10
              pb-2 text-xs font-semibold tracking-wider uppercase
            ">
              <span>{it.judul}</span><span class="font-normal text-secondary">{it.tag}</span>
            </div>
            <p class="text-sm/relaxed text-secondary">{it.teks}</p>
            <ul class="space-y-1.5 pt-2 text-xs text-secondary">
              {it.poin.map((p) => <li class="flex items-center gap-2"><span class="
                size-1 rounded-full bg-primary
              "></span>{p}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
